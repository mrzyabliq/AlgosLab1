file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
set(expected_graph 0 7 9 20 20 11)
set(expected_bipartite 0 2 2 1 1 1 3)
set(expected_complete_bipartite_k3_3 0 2 2 1 1 1)
set(expected_path_p6 0 1 2 3 4 5)
set(expected_cycle_c5 0 1 2 2 1)
set(expected_complete_k5 0 1 1 1 1)
set(expected_star_s6 0 1 1 1 1 1)
set(expected_tree_t7 0 1 1 2 2 2 2)
set(expected_grid_2x3 0 1 2 1 2 3)
set(expected_wheel_w7 0 1 1 1 1 1 1)
set(expected_dag 0 2 3 4 5 7)
foreach(name IN ITEMS graph bipartite complete_bipartite_k3_3 path_p6 cycle_c5 complete_k5 star_s6 tree_t7 grid_2x3 wheel_w7 dag)
    set(directory "${TEST_DIRECTORY}/${name}")
    file(MAKE_DIRECTORY "${directory}")
    execute_process(COMMAND "${PROGRAM}" "${EXAMPLES_DIRECTORY}/${name}.txt"
        WORKING_DIRECTORY "${directory}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Example ${name} failed: ${error}")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    set(vertex 0)
    foreach(distance IN LISTS expected_${name})
        math(EXPR vertex "${vertex} + 1")
        string(FIND "${output}" "${vertex}: ${distance}\n" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Wrong distance in ${name}: expected ${vertex}: ${distance}; got ${output}")
        endif()
    endforeach()
    file(READ "${directory}/graph.html" html)
    string(FIND "${html}" "id=\"graph\"" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Example ${name} has no graph visualization")
    endif()
endforeach()
foreach(option IN ITEMS --help -h)
    execute_process(COMMAND "${PROGRAM}" "${option}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Help failed")
    endif()
    foreach(marker IN ITEMS --random --benchmark matrix-file graph.html "n-1 <= m")
        string(FIND "${output}" "${marker}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing help text: ${marker}")
        endif()
    endforeach()
endforeach()
set(args_random 8 16)
set(args_random_source 7 6 4)
set(args_random_complete 5 20 5)
set(args_random_single 1 0)
set(data_random "\"n\":8,\"m\":16,\"source\":1")
set(data_random_source "\"n\":7,\"m\":6,\"source\":4")
set(data_random_complete "\"n\":5,\"m\":20,\"source\":5")
set(data_random_single "\"n\":1,\"m\":0,\"source\":1")
foreach(name IN ITEMS random random_source random_complete random_single)
    set(directory "${TEST_DIRECTORY}/${name}")
    file(MAKE_DIRECTORY "${directory}")
    execute_process(COMMAND "${PROGRAM}" --random ${args_${name}}
        WORKING_DIRECTORY "${directory}" TIMEOUT 5
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "0" OR output MATCHES "INF")
        message(FATAL_ERROR "Random graph ${name} failed: ${output} ${error}")
    endif()
    file(READ "${directory}/graph.html" html)
    string(FIND "${html}" "${data_${name}}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Wrong vertex/edge count or source for ${name}")
    endif()
endforeach()
file(WRITE "${TEST_DIRECTORY}/random_input.txt" "4 5\n")
file(MAKE_DIRECTORY "${TEST_DIRECTORY}/random_stdin")
execute_process(COMMAND "${PROGRAM}" --random INPUT_FILE "${TEST_DIRECTORY}/random_input.txt"
    WORKING_DIRECTORY "${TEST_DIRECTORY}/random_stdin" TIMEOUT 5
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "n=4, m=5, source=1" OR output MATCHES "INF")
    message(FATAL_ERROR "Random keyboard input failed: ${output} ${error}")
endif()
set(args_bad_n --random 0 0)
set(args_bad_low_m --random 5 3)
set(args_bad_high_m --random 5 21)
set(args_bad_source --random 5 8 6)
set(args_bad_number --random 5x 8)
set(args_missing_m --random 5)
set(args_unknown --unknown)
foreach(name IN ITEMS bad_n bad_low_m bad_high_m bad_source bad_number missing_m unknown)
    execute_process(COMMAND "${PROGRAM}" ${args_${name}} WORKING_DIRECTORY "${TEST_DIRECTORY}"
        TIMEOUT 5 RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT "${result}" STREQUAL "1")
        message(FATAL_ERROR "Invalid arguments ${name} must exit with code 1, got ${result}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEST_DIRECTORY}/stdin")
execute_process(COMMAND "${PROGRAM}" "-" INPUT_FILE "${EXAMPLES_DIRECTORY}/dag.txt"
    WORKING_DIRECTORY "${TEST_DIRECTORY}/stdin" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "6: 7")
    message(FATAL_ERROR "Standard input failed: ${output} ${error}")
endif()
foreach(name IN ITEMS invalid_source negative_weight incomplete)
    if(name STREQUAL "invalid_source")
        set(contents "2 3\n0 1\n-1 0\n")
    elseif(name STREQUAL "negative_weight")
        set(contents "2 1\n0 -2\n-1 0\n")
    else()
        set(contents "2 1\n0 1\n")
    endif()
    file(WRITE "${TEST_DIRECTORY}/${name}.txt" "${contents}")
    execute_process(COMMAND "${PROGRAM}" "${TEST_DIRECTORY}/${name}.txt"
        WORKING_DIRECTORY "${TEST_DIRECTORY}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if("${result}" STREQUAL "0")
        message(FATAL_ERROR "Invalid matrix ${name} was accepted")
    endif()
endforeach()
