file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
execute_process(COMMAND "${PROGRAM}"
    WORKING_DIRECTORY "${TEST_DIRECTORY}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Benchmark failed: ${error}")
endif()
file(READ "${TEST_DIRECTORY}/benchmark.html" benchmark)
if(NOT EXISTS "${TEST_DIRECTORY}/benchmark_samples.csv")
    message(FATAL_ERROR "Individual benchmark measurements were not saved")
endif()
foreach(marker IN ITEMS "id=\"sparse\"" "id=\"medium\"" "id=\"dense\"" "id=\"manyDecreases\""
                        "\"n\":100,\"m\":400," "\"n\":100,\"m\":2475," "\"n\":100,\"m\":2549,"
                        "\"n\":1000,\"m\":4000," "\"n\":1000,\"m\":249750," "\"n\":1000,\"m\":250499,"
                        "new Chart(" "chart.js@4.6.1")
    string(FIND "${benchmark}" "${marker}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing benchmark graph or n/m point: ${marker}")
    endif()
endforeach()
string(REGEX MATCHALL "<canvas id=" charts "${benchmark}")
list(LENGTH charts count)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "Expected four Chart.js canvases, including the decrease-key stress test")
endif()
string(REGEX MATCH "const medium = \\[[^;]*\\];" medium "${benchmark}")
string(REGEX MATCHALL "\\{\"n\":[0-9]+,\"m\":[0-9]+," points "${medium}")
if(NOT points)
    message(FATAL_ERROR "Missing medium graph points")
endif()
foreach(point IN LISTS points)
    string(REGEX REPLACE ".*\"n\":([0-9]+),.*" "\\1" n "${point}")
    string(REGEX REPLACE ".*\"m\":([0-9]+),.*" "\\1" m "${point}")
    math(EXPR sparse_edges "4 * ${n}")
    math(EXPR dense_edges "${n} * (${n} - 1) / 4")
    if(m LESS_EQUAL sparse_edges OR m GREATER_EQUAL dense_edges)
        message(FATAL_ERROR "Medium graph edge count is outside its interval: n=${n}, m=${m}")
    endif()
endforeach()
